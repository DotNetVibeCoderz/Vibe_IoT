<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>IoTCom.Net</RootNamespace>
    <Description>IoTCom.Net — complete IoT communication protocol library for .NET 10 (meta-package). Brings Core, Framing (CRC/SLIP/COBS/HDLC), Modbus TCP/RTU/ASCII, NMEA 0183, Art-Net/sACN, HL7 v2/MLLP, CoAP, MAVLink, LoRaWAN (Semtech UDP, light network server), DLMS/COSEM and M-Bus metering, AT-command modems, ASTM lab analyzers, mDNS/DNS-SD discovery, MQTT, Sparkplug B, SenML, TLV, serial, CAN/CAN FD (SocketCAN, slcan, gs_usb, PCAN) with CANopen, Bluetooth LE and USB/HID transports and Hosting with one reference. Built by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>$(PackageTags);nmea;artnet;sacn;hl7;coap;mavlink;senml;serial;can</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IoTCom.Net.Abstractions\IoTCom.Net.Abstractions.csproj" />
    <ProjectReference Include="..\IoTCom.Net.Core\IoTCom.Net.Core.csproj" />
