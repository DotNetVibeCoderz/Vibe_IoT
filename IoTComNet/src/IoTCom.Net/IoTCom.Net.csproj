    <ProjectReference Include="..\IoTCom.Net.Transport.Can.Adapters\IoTCom.Net.Transport.Can.Adapters.csproj" />
    <ProjectReference Include="..\IoTCom.Net.Protocols.CanOpen\IoTCom.Net.Protocols.CanOpen.csproj" />
    <ProjectReference Include="..\IoTCom.Net.Protocols.Modbus\IoTCom.Net.Protocols.Modbus.csproj" />
    <ProjectReference Include="..\IoTCom.Net.Protocols.Nmea\IoTCom.Net.Protocols.Nmea.csproj" />
