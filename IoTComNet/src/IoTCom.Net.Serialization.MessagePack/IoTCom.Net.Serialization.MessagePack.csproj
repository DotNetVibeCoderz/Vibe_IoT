<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>IoTCom.Net.Serialization.MessagePack</RootNamespace>
    <Description>MessagePack adapter for IoTCom.Net over MessagePack-CSharp: an IPayloadCodec bound to your (source-generated) resolver, and a JSON view of any MessagePack payload for logs, the traffic tap and the frame lane. Built by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>$(PackageTags);messagepack;msgpack;serialization;codec</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IoTCom.Net.Abstractions\IoTCom.Net.Abstractions.csproj" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
