<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>IoTCom.Net.Cli</RootNamespace>
    <AssemblyName>iotcom</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>iotcom</ToolCommandName>
    <PackageId>IoTCom.Net.Cli</PackageId>
    <Description>iotcom — the IoTCom.Net command-line tool: read/write/serve Modbus, decode frames byte by byte, compute 20+ CRCs, SLIP/COBS/HDLC, NMEA listen/simulate, Art-Net send/poll/monitor, MQTT pub/sub/broker, HL7 listen/send/simulate, DICOM echo/send/listen, and serial port discovery. Built by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>iot;cli;modbus;mqtt;nmea;artnet;crc;dotnet-tool;gravicode;iotcom</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepoRoot)assets/icon/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepoRoot)assets/nuget/README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\IoTCom.Net\IoTCom.Net.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Native.Modbus\IoTCom.Net.Native.Modbus.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Adapters.Dicom\IoTCom.Net.Adapters.Dicom.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Protocols.Uds\IoTCom.Net.Protocols.Uds.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Protocols.Coap\IoTCom.Net.Protocols.Coap.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Protocols.Mavlink\IoTCom.Net.Protocols.Mavlink.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Serialization.Protobuf\IoTCom.Net.Serialization.Protobuf.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Serialization.MessagePack\IoTCom.Net.Serialization.MessagePack.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Adapters.OpcUa\IoTCom.Net.Adapters.OpcUa.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Transport.Ble\IoTCom.Net.Transport.Ble.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Transport.Usb\IoTCom.Net.Transport.Usb.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Transport.Can.Adapters\IoTCom.Net.Transport.Can.Adapters.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Protocols.CanOpen\IoTCom.Net.Protocols.CanOpen.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Protocols.J1939\IoTCom.Net.Protocols.J1939.csproj" />
    <ProjectReference Include="..\..\src\IoTCom.Net.Protocols.Iec104\IoTCom.Net.Protocols.Iec104.csproj" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>
</Project>
