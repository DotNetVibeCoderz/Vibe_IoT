{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MQTTnet": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "LineName": "Line 1",
    "Simulate": true,
    "Plc": { "Host": "127.0.0.1", "Port": 1502, "UnitId": 1 },
    "PollIntervalMs": 500,
    "AllowWrites": true,
    "Mqtt": {
      "EmbeddedBroker": true,
      "Host": "127.0.0.1",
      "Port": 1883,
      "Topic": "iotcom/line1/plc"
    }
  }
}
