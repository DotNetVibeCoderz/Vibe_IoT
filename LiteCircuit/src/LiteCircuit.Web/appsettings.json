{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=litecircuit.db",
    "SqlServer": "Server=localhost;Database=LiteCircuit;Trusted_Connection=True;TrustServerCertificate=True",
    "Postgres": "Host=localhost;Database=litecircuit;Username=postgres;Password=postgres",
    "MySql": "Server=localhost;Database=litecircuit;User=root;Password=root"
  },

  "Storage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "Path": "wwwroot/uploads",
      "PublicBase": "/uploads"
    },
    "AzureBlob": {
      "ConnectionString": "",
      "Container": "litecircuit"
    },
    "S3": {
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "litecircuit",
      "Region": "us-east-1",
      "ServiceUrl": ""
    }
  },

  "Ai": {
    "Provider": "OpenAI",
    "Model": "gpt-4o-mini",
    "ApiKey": "sk-proj-xxx",
    "Endpoint": "https://api.openai.com/v1",
    "Temperature": 0.7,
    "MaxTokens": 4000,
    "SystemPrompt": "You are Electra ⚡ — LiteCircuit's PCB design copilot. You are precise, practical and friendly. You help with schematics, PCB layout, component selection, firmware pointers and manufacturing. Use the available functions to search the internet, query the component library, inspect the user's projects and run design rule checks. Answer in the user's language. Format answers in markdown; use tables for comparisons and code blocks for firmware or scripts.",
    "Providers": {
      "OpenAI": {
        "Model": "gpt-4o-mini",
        "Endpoint": "https://api.openai.com/v1",
        "ApiKey": "sk-proj-xxxx"
      },
      "Anthropic": {
        "Model": "claude-sonnet-5",
        "Endpoint": "https://api.anthropic.com/v1/",
        "ApiKey": ""
      },
      "Gemini": {
        "Model": "gemini-2.0-flash",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "ApiKey": ""
      },
      "Ollama": {
        "Model": "llama3.2",
        "Endpoint": "http://localhost:11434/v1",
        "ApiKey": ""
      }
    }
  },
  "Tavily": {
    "ApiKey": "tvly-dev-xxx"
  }
}
