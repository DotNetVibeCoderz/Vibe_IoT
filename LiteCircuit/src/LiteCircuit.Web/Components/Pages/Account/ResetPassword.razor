@page "/account/reset-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav

<PageTitle>Choose a new password — LiteCircuit</PageTitle>

<div class="auth-card">
    <div class="auth-head">
        <h1>Choose a new password</h1>
    </div>

    @if (error is not null)
    {
        <div class="alert alert-error">@error</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="Reset" FormName="reset">
        <DataAnnotationsValidator />
        <label>New password <span class="hint">(min. 8 characters)</span>
            <InputText type="password" @bind-Value="Input.Password" autocomplete="new-password" />
        </label>
        <button type="submit" class="btn-copper btn-block">Set password</button>
    </EditForm>
</div>

@code {
    private string? error;

    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? Email { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }

    private async Task Reset()
    {
        var user = Email is null ? null : await UserManager.FindByEmailAsync(Email);
        if (user is null || Token is null) { error = "The reset link is invalid."; return; }
        var result = await UserManager.ResetPasswordAsync(user, Token, Input.Password);
        if (result.Succeeded) Nav.NavigateTo("/account/login", forceLoad: true);
        else error = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class InputModel
    {
        [Required, MinLength(8)] public string Password { get; set; } = "";
    }
}
